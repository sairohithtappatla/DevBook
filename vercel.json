{
  "rewrites": [
    { "source": "/mcp", "has": [{ "type": "host", "value": "(?<host>.+)" }], "destination": "https://6ktij8hk.function2.insforge.app/devbook-mcp?origin_host=:host" },
    { "source": "/.well-known/oauth-protected-resource", "has": [{ "type": "host", "value": "(?<host>.+)" }], "destination": "https://6ktij8hk.function2.insforge.app/devbook-oauth/.well-known/oauth-protected-resource?origin_host=:host" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "has": [{ "type": "host", "value": "(?<host>.+)" }], "destination": "https://6ktij8hk.function2.insforge.app/devbook-oauth/.well-known/oauth-protected-resource/mcp?origin_host=:host" },
    { "source": "/.well-known/oauth-authorization-server", "has": [{ "type": "host", "value": "(?<host>.+)" }], "destination": "https://6ktij8hk.function2.insforge.app/devbook-oauth/.well-known/oauth-authorization-server?origin_host=:host" },
    { "source": "/oauth/token", "destination": "https://6ktij8hk.function2.insforge.app/devbook-oauth/token" },
    { "source": "/oauth/register", "destination": "https://6ktij8hk.function2.insforge.app/devbook-oauth/register" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
